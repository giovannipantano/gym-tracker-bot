# --- Obbligatorio ---------------------------------------------------------
# Chiave per firmare i link di disiscrizione (min. 32 caratteri). Generala con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_questa_chiave_con_una_lunga_e_casuale
# URL pubblico dell'app (usato nei link delle email)
BASE_URL=https://gym.tuodominio.it

# --- Registrazione --------------------------------------------------------
# Se impostato, chi si registra deve inserire questo codice (utile per famiglia e amici). Vuoto = aperta a tutti.
REGISTRATION_INVITE_CODE=
# true = non si accede finché l'email non è verificata (richiede SMTP funzionante)
REQUIRE_EMAIL_VERIFICATION=false
# Durata della sessione, in giorni
SESSION_DAYS=30

# --- Invio email (SMTP) ---------------------------------------------------
# Senza SMTP l'app funziona, ma le email (verifica, reset password, novità) vengono solo scritte nel log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Gym Tracker <noreply@tuodominio.it>

# --- Dati e backup --------------------------------------------------------
# Percorsi relativi = rispetto alla radice del progetto
DATABASE_PATH=workout_tracker.db
BACKUP_DIR=backups
BACKUP_KEEP=14
